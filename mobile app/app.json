{
  "expo": {
    "name": "DigitPointage",
    "slug": "digitpointage",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Original_Logo_Cyan_with_White_Background.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c2c2d639-f8c6-4dbb-8325-067daf4d7818"
      }
    },
    "android": {
      "package": "com.charel03.boltexponativewind"
    }
  }
}
